config {
  type: "view",
  schema: "cta_analytics",
  name: "rail_station_data_quality",
  tags: ["cta","analytics"],
  description: "One row per station-day with conflicting source entry counts. Retains evidence and explains why the reporting views exclude those counts. A real data-quality exception list, not fabricated failures.",
  columns: {
    "station_id": "CTA rail station identifier at station grain; matches cta.l_stops.map_id.",
    "service_date": "Service calendar date in Chicago local time. GTFS times after 24:00 remain attached to this service date.",
    "station_name": "Station name.",
    "reported_station_name": "Reported station name.",
    "source_row_count": "Number of raw source rows contributing to this station-day.",
    "has_current_station_metadata": "True when this station ID is in the current station/platform list.",
    "issue": "Explanation of the observed quality problem."
  }
}

SELECT
  station_id,
  service_date,
  station_name,
  reported_station_name,
  source_row_count,
  has_current_station_metadata,
  'Conflicting station-day counts; entries excluded from reported sums' AS issue
FROM
  ${ref("cta_staging", "rail_station_ridership_daily")}
WHERE
  has_conflicting_entries
