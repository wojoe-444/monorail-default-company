config {
  type: "table",
  schema: "executive_reporting",
  name: "department_scorecard",
  tags: ["enterprise","executive_scorecard"],
  description: "Departmental scorecard joining staffing, partial-period finance, synthetic reliability and maintenance risk. Demonstrates cross-domain lineage. Fictional demonstration outputs, not official CTA personnel, service or financial records.",
  columns: {
    "report_month": "First day of the budget/report month. November actuals cover only the loaded demonstration period.",
    "department_id": "Synthetic department key; joins org.departments.",
    "department_name": "Department display name.",
    "manager_name": "Invented department-manager name.",
    "active_staff": "Current active headcount, counted from the fictional staff directory.",
    "budget_usd": "Budget usd.",
    "total_actual_cost_usd": "Modeled labor plus approved invoices plus approved expenses. November is partial-period; pending invoices are excluded.",
    "remaining_budget_usd": "Full monthly synthetic budget minus loaded partial-period actual cost; negative indicates the seeded over-budget scenario.",
    "budget_status": "OverBudget or WithinBudget based on the loaded synthetic actuals.",
    "period_status": "PartialPeriodActuals when time entries exist; BudgetOnly otherwise.",
    "completed_trips": "Completed trips.",
    "cancelled_trips": "Cancelled trips.",
    "on_time_ratio": "On-time trips divided by completed trips, as a 0-to-1 fraction. These delivered-service values are synthetic.",
    "open_work_orders": "Repair orders whose status is Open.",
    "critical_open_orders": "Open repair orders whose priority is Critical; a deliberately seeded demonstration risk."
  }
}

WITH
  ops AS (
    SELECT
      DATE_TRUNC(service_date, MONTH) AS report_month,
      department_id,
      SUM(completed_trips) AS completed_trips,
      SUM(cancelled_trips) AS cancelled_trips,
      SAFE_DIVIDE(SUM(on_time_trips), SUM(completed_trips)) AS on_time_ratio
    FROM
      ${ref("ops_reporting", "route_performance_daily")}
    GROUP BY
      1,
      2
  ),
  fleet AS (
    SELECT
      maintenance_department_id AS department_id,
      SUM(open_work_orders) AS open_work_orders,
      SUM(critical_open_orders) AS critical_open_orders
    FROM
      ${ref("ops_reporting", "maintenance_backlog")}
    GROUP BY
      1
  )
SELECT
  f.report_month,
  f.department_id,
  f.department_name,
  s.manager_name,
  s.active_staff,
  f.budget_usd,
  f.total_actual_cost_usd,
  f.remaining_budget_usd,
  f.budget_status,
  f.period_status,
  COALESCE(o.completed_trips, 0) AS completed_trips,
  COALESCE(o.cancelled_trips, 0) AS cancelled_trips,
  o.on_time_ratio,
  COALESCE(m.open_work_orders, 0) AS open_work_orders,
  COALESCE(m.critical_open_orders, 0) AS critical_open_orders
FROM
  ${ref("finance_reporting", "budget_variance")} f
  JOIN ${ref("org_reporting", "department_staffing")} s USING (department_id)
  LEFT JOIN ops o USING (report_month, department_id)
  LEFT JOIN fleet m USING (department_id)
